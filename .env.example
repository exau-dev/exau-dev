# Clé API Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# --- Publication LinkedIn (optionnel) ---
# Nécessite une app LinkedIn Developer avec les scopes w_organization_social
# (ou w_member_social pour un profil perso) et un access token valide.
# Voir README.md > "Publication LinkedIn" pour la marche à suivre.
LINKEDIN_ACCESS_TOKEN=
# URN de la page/organisation LinkedIn, ex: urn:li:organization:12345678
LINKEDIN_AUTHOR_URN=
